GIGBID_API_TOKEN=change-this-before-deploying
# Use production on a public host; the API then refuses known demo tokens.
GIGBID_ENV=development
# Persistent volume directory shared by the API and MCP subprocesses.
GIGBID_DATA_DIR=./local_data
GIGBID_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
GIGBID_MODE=local
GIGBID_DATABASE_URL=sqlite:///./gigbid.sqlite
GIGBID_GIGSIM_URL=http://gigsim:8000
GIGBID_GIGSIM_TOKEN=
GIGBID_UPWORK_TOKEN=
GIGBID_MCP_BEARER=change-this-too
GIGBID_OLLAMA_URL=http://localhost:11434
GIGBID_RAG_BACKEND=lexical
# For real local embeddings: GIGBID_RAG_BACKEND=ollama-vector
GIGBID_OLLAMA_EMBEDDING_MODEL=nomic-embed-text
GIGBID_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
GIGBID_LLM_BACKEND=template
GIGBID_MODEL_PROFILE=open
GIGBID_TOOL_BACKEND=mcp
GIGBID_MCP_TIMEOUT=25
GIGBID_MAX_OUTPUT_TOKENS=180
GIGBID_MCP_RATE_LIMIT=60
GIGBID_MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1:*
GIGBID_MCP_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
GIGBID_CHECKPOINT_DATABASE_URL=
GIGBID_GITHUB_TOKEN=
# Upwork OAuth is interactive and its endpoint must be approved for hosted clients.
# GIGBID_UPWORK_OAUTH_BEARER=
