{
  "components": {
    "schemas": {
      "AnalyzeRequest": {
        "properties": {
          "job_id": {
            "title": "Job Id",
            "type": "string"
          },
          "persona": {
            "pattern": "^(ai|web|analytics)$",
            "title": "Persona",
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "persona"
        ],
        "title": "AnalyzeRequest",
        "type": "object"
      },
      "ApprovalRequest": {
        "properties": {
          "action": {
            "pattern": "^(approve|reject)$",
            "title": "Action",
            "type": "string"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Text"
          }
        },
        "required": [
          "action"
        ],
        "title": "ApprovalRequest",
        "type": "object"
      },
      "Body_upload_portfolio_portfolio_upload_post": {
        "properties": {
          "file": {
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "type": "string"
          }
        },
        "required": [
          "file"
        ],
        "title": "Body_upload_portfolio_portfolio_upload_post",
        "type": "object"
      },
      "Credentials": {
        "properties": {
          "email": {
            "maxLength": 254,
            "minLength": 3,
            "title": "Email",
            "type": "string"
          },
          "invite_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Invite Code"
          },
          "password": {
            "maxLength": 256,
            "minLength": 12,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "Credentials",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "MessageRequest": {
        "properties": {
          "incoming": {
            "maxLength": 5000,
            "minLength": 1,
            "title": "Incoming",
            "type": "string"
          },
          "job_id": {
            "title": "Job Id",
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "incoming"
        ],
        "title": "MessageRequest",
        "type": "object"
      },
      "RegenerateRequest": {
        "properties": {
          "paragraph_index": {
            "maximum": 50.0,
            "minimum": 0.0,
            "title": "Paragraph Index",
            "type": "integer"
          },
          "text": {
            "maxLength": 15000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "paragraph_index",
          "text"
        ],
        "title": "RegenerateRequest",
        "type": "object"
      },
      "SavedSearchRequest": {
        "properties": {
          "interval_hours": {
            "maximum": 168.0,
            "minimum": 4.0,
            "title": "Interval Hours",
            "type": "integer"
          },
          "persona": {
            "pattern": "^(ai|web|analytics)$",
            "title": "Persona",
            "type": "string"
          },
          "query": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Query",
            "type": "string"
          }
        },
        "required": [
          "query",
          "persona",
          "interval_hours"
        ],
        "title": "SavedSearchRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
