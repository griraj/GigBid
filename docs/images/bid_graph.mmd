---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__(<p>__start__</p>)
	analyst(analyst)
	risk(risk)
	fit(fit)
	decide(decide)
	price(price)
	writer(writer)
	critic(critic)
	revise(revise)
	compliance(compliance)
	approval(approval)
	submit(submit)
	__end__(<p>__end__</p>)
	__start__ -.-> analyst;
	__start__ -.-> fit;
	__start__ -.-> risk;
	analyst --> decide;
	fit --> decide;
	risk --> decide;
	decide --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
