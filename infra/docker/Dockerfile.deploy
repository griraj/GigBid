FROM node:22-alpine AS web
WORKDIR /web
COPY apps/web/package*.json ./
RUN npm ci
COPY apps/web/ ./
ENV VITE_API_URL=/api
RUN npm run build

FROM python:3.12-slim
WORKDIR /app
COPY pyproject.toml ./
COPY agent ./agent
COPY apps/__init__.py ./apps/__init__.py
COPY apps/api ./apps/api
COPY data ./data
COPY rag ./rag
COPY mcp_servers ./mcp_servers
COPY docs/TECHNICAL_WRITEUP.md ./docs/TECHNICAL_WRITEUP.md
RUN pip install --no-cache-dir . langgraph-checkpoint-sqlite
COPY --from=web /web/dist ./apps/web/dist
RUN useradd --create-home gigbid && mkdir -p /app/local_data && chown -R gigbid:gigbid /app
ENV GIGBID_DATA_DIR=/app/local_data
ENV GIGBID_MCP_PERSISTENT=1 OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
ENV GIGBID_STORAGE_EPHEMERAL=true
USER gigbid
EXPOSE 8000
CMD ["uvicorn","apps.api.hosted:application","--host","0.0.0.0","--port","8000"]
